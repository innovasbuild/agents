{
	"name": "innovas-agents",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint:fix": "biome check --write .",
		"db:start": "npx supabase start",
		"db:stop": "npx supabase stop",
		"db:reset": "npx supabase db reset",
		"db:test": "npx supabase db reset --no-seed && npx supabase test db",
		"db:types": "npx supabase gen types typescript --linked > lib/supabase/database.types.ts"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.116.0",
		"@vercel/connect": "1.0.0",
		"ai": "^7.0.93",
		"eve": "0.54.2",
		"next": "16.3.5",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^24.13.4",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^5.0.0"
	}
}
