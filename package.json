{
	"name": "innovas-agents",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "vitest run",
		"test:it": "OUTREACH_IT=1 node --env-file=.env.eval ./node_modules/vitest/vitest.mjs run tests/outreach/store.it.test.ts",
		"test:it:workflows": "WORKFLOWS_IT=1 node --env-file=.env.eval ./node_modules/vitest/vitest.mjs run tests/workflows/store.it.test.ts",
		"lint:fix": "biome check --write .",
		"db:start": "npx supabase start",
		"db:stop": "npx supabase stop",
		"db:reset": "npx supabase db reset",
		"db:test": "npx supabase db reset --no-seed && npx supabase test db",
		"db:types": "npx supabase gen types typescript --linked > lib/supabase/database.types.ts",
		"connections:bind": "node --env-file=.env.local scripts/connections-bind.mts",
		"brain:import": "node --env-file=.env.local scripts/brain-import.mts",
		"outreach:config": "node --env-file=.env.local scripts/outreach-config.mts",
		"executors:set": "node --env-file=.env.local scripts/executors-set.mts",
		"workflows:set": "node --env-file=.env.local scripts/workflows-set.mts",
		"evals": "node --env-file=.env.local --env-file=.env.eval scripts/run-evals.mts"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.116.0",
		"@vercel/connect": "1.0.0",
		"ai": "^7.0.93",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.3.0",
		"eve": "0.54.2",
		"lucide-react": "^1.45.0",
		"next": "16.3.5",
		"radix-ui": "^1.6.7",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tw-animate-css": "^1.4.0",
		"yaml": "^2.9.1",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^24.13.4",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"shadcn": "^4.21.0",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^5.0.0"
	}
}
