{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{ "type": "command", "command": ".claude/hooks/check-gstack.sh" }
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{ "type": "command", "command": "npm run typecheck --silent" },
					{ "type": "command", "command": "npm run docs:check --silent" }
				]
			}
		]
	},
	"permissions": {
		"allow": [
			"Bash(npm run *)",
			"Bash(npx supabase *)",
			"Bash(npx eve *)",
			"Bash(git status*)",
			"Bash(git diff*)"
		]
	}
}
