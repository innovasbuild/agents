				"Un tenant nuevo es una fila en tenants más su canon en el brain"
			]
		},
		{
			"dot": "emerald",
			"title": "Nada sale sin aprobación",
			"items": [
				"send_email lleva approval: always(): la sesión eve espera al ejecutor",
				"crm_upsert_contact lleva approval: once() por sesión",
				"research_account arma la ficha de páginas públicas y la guarda 90 días"
			]
		},
		{
			"dot": "violet",
			"title": "La base y las credenciales",
			"items": [
				"events es append-only; contacts y queue_items son estado derivado",
				"RLS por tenant_id vía memberships, con platform_admin por encima",
				"Connect guarda los grants: el agente recibe la conexión ya autenticada"
			]
